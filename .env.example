# Browser-safe configuration only. Never place credentials in VITE_* variables.
VITE_SHROUDLY_DEPLOYMENT_ID=shroudly-preprod-<immutable-id>
# Token-free routing only. Authenticated browser integration is a separate gate;
# never append a provider project_id or token to browser-visible configuration.
VITE_SHROUDLY_RPC_URL=https://rpc.midnight-preprod.blockfrost.io
VITE_SHROUDLY_INDEXER_URL=https://midnight-preprod.blockfrost.io/api/v0
VITE_SHROUDLY_ZK_CONFIG_URL=
VITE_SHROUDLY_SPONSOR_URL=
VITE_SHROUDLY_ASSET_CONTRACT_ID=
VITE_SHROUDLY_RANDOMNESS_CONTRACT_ID=
VITE_SHROUDLY_YIELD_CONTRACT_ID=
VITE_SHROUDLY_POOL_CONTRACT_ID=
VITE_SHROUDLY_ASSET_ARTIFACT_HASH=
VITE_SHROUDLY_RANDOMNESS_ARTIFACT_HASH=
VITE_SHROUDLY_YIELD_ARTIFACT_HASH=
VITE_SHROUDLY_POOL_ARTIFACT_HASH=

# Server-side provider names only. Values belong in provider secret stores and
# are intentionally absent from this repository.
MIDNIGHT_DEPLOYER_SECRET_NAME=shroudly-preprod-deployer
MIDNIGHT_GOVERNANCE_SECRET_NAME=shroudly-preprod-governance
MIDNIGHT_RESERVE_SECRET_NAME=shroudly-preprod-reserve
MIDNIGHT_RANDOMNESS_SECRET_NAME=shroudly-preprod-randomness
MIDNIGHT_KEYCHAIN_ACCOUNT=shroudly-preprod
# Full Keychain service reference, not the Blockfrost token itself.
MIDNIGHT_BLOCKFROST_SECRET_NAME=com.shroudly.preprod.blockfrost
# Optional dedicated Chrome user data directory; set an absolute path locally.
MIDNIGHT_CHROME_USER_DATA_DIR=
MIDNIGHT_WALLET_SERVICE_PREFIX=com.shroudly.preprod.wallet.
MIDNIGHT_AUTHORITY_SERVICE_PREFIX=com.shroudly.preprod.authority.
# Server-only Sponsor Service configuration. Keep all values in the approved
# deployment secret store; never copy them into VITE_* variables.
MIDNIGHT_SPONSOR_DEPLOYMENT_ID=
MIDNIGHT_SPONSOR_CONTRACT_IDS=
MIDNIGHT_SPONSOR_CIRCUIT_IDS=
MIDNIGHT_SPONSOR_UPSTREAM_URL=
MIDNIGHT_SPONSOR_UPSTREAM_TOKEN=
# Render randomness signer configuration. The endpoint is public routing;
# credentials and provider values remain in the isolated Render secret store
# or the matching contributor runner.
SHROUDLY_RENDER_AUTOMATION_ENDPOINT=
SHROUDLY_RENDER_AUTOMATION_TOKEN=
SHROUDLY_RANDOMNESS_DEPLOYMENT_ID=
SHROUDLY_RANDOMNESS_CONTRACT_ID=
SHROUDLY_RANDOMNESS_UPSTREAM_URL=
SHROUDLY_RANDOMNESS_UPSTREAM_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_FROM=
BETTER_STACK_HEARTBEAT_URL=

# Protected Stage 4 deployment configuration. These are names/URLs only;
# seeds, authority values, and passwords stay in macOS Keychain or protected
# local storage and must never be copied into this file.
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
MIDNIGHT_INDEXER_HTTP_URL=https://midnight-preprod.blockfrost.io/api/v0
MIDNIGHT_INDEXER_WS_URL=wss://midnight-preprod.blockfrost.io/api/v0/ws
MIDNIGHT_RPC_URL=wss://rpc.midnight-preprod.blockfrost.io
MIDNIGHT_PRIVATE_STATE_DB=.midnight/preprod-private-state
MIDNIGHT_PRIVATE_STATE_PASSWORD_NAME=shroudly-preprod-private-state-password
MIDNIGHT_PRIVATE_STATE_SERVICE_PREFIX=com.shroudly.preprod.private-state.
MIDNIGHT_AUTOMATION_WALLET_SECRET_NAME=shroudly-preprod-automation-wallet

pragma language_version >= 0.22 && <= 0.23;
import CompactStandardLibrary;
// Isolated valueless recovery feasibility probe for issue #24. Not the
// Prize-Savings Pool, tMIX, or an authority/ADR migration.
//
// Each participant is a public identity hash with a commitment to
// (secret, round) and a public round count. An action succeeds only when the
// participant's private witness material is current: a restored older copy, or
// one missing the newest round, cannot prove it, so decryption alone never
// establishes freshness. Identities are public here by design; this is a
// diagnostic probe, not a privacy claim (ADR 0005).
export ledger commitments: Map<Bytes<32>, Bytes<32>>;
export ledger rounds: Map<Bytes<32>, Uint<64>>;
export ledger total: Counter;

witness secretKey(): Bytes<32>;
witness privateRound(): Uint<64>;
// Advances the participant's private round as part of the same circuit call.
witness advanceLocal(): Uint<64>;

export pure circuit identity(key: Bytes<32>): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>]>([pad(32, "Shroudly/recovery-id"), key]);
}

export pure circuit bind(key: Bytes<32>, at: Uint<64>): Bytes<32> {
  return persistentHash<[Bytes<32>, Uint<64>, Bytes<32>]>([pad(32, "Shroudly/recovery-probe"), at, key]);
}

export circuit register(): [] {
  const key = secretKey();
  const id = disclose(identity(key));
  assert(!commitments.member(id), "already registered");
  commitments.insert(id, disclose(bind(key, 0)));
  rounds.insert(id, 0);
  total.increment(1);
}

export circuit advance(): [] {
  const key = secretKey();
  const id = disclose(identity(key));
  assert(commitments.member(id), "not registered");
  const at = privateRound();
  assert(disclose(bind(key, at) == commitments.lookup(id)), "private state is stale or foreign");
  const next = advanceLocal();
  commitments.insert(id, disclose(bind(key, next)));
  rounds.insert(id, (rounds.lookup(id) + 1) as Uint<64>);
  total.increment(1);
}

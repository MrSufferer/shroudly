{
  "name": "shroudly",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "build:production": "pnpm --filter @shroudly/web build:production",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:contracts": "pnpm --filter @shroudly/contracts test",
    "test:midnight-deploy": "node --test scripts/midnight-deploy-preprod.test.mjs",
    "test:preprod-access": "node --test scripts/preprod-access.test.mjs",
    "test:randomness": "pnpm --filter @shroudly/randomness-signer test",
    "test:web": "pnpm --filter @shroudly/web test",
    "test:e2e": "pnpm --filter @shroudly/web test:e2e",
    "dev": "pnpm --filter @shroudly/web dev",
    "test:sponsor": "pnpm --filter @shroudly/sponsor test",
    "midnight:profile": "node scripts/midnight-profile.mjs",
    "midnight:access": "node scripts/preprod-access.mjs",
    "midnight:compile": "node scripts/compile-midnight.mjs --skip-zk",
    "midnight:compile:keys": "node scripts/compile-midnight.mjs",
    "midnight:deploy:preprod": "node scripts/midnight-deploy-preprod.mjs",
    "midnight:test": "pnpm --filter @shroudly/web test && pnpm --filter @shroudly/contracts test && pnpm test:midnight-deploy",
    "render:stage7": "node scripts/deploy-render-stage7.mjs",
    "midnight:check": "pnpm midnight:profile && pnpm midnight:compile:keys && pnpm midnight:profile && pnpm midnight:test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "pino": "10.3.1",
    "rxjs": "7.8.2",
    "ws": "8.21.0"
  },
  "pnpm": {
    "overrides": {
      "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
    }
  }
}
